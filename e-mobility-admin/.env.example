# Frontend Environment Variables
# Copy this file to .env and fill in real values
# These variables are BAKED into the build at build time (prefixed with VITE_)

# Backend API URL (your Render backend service URL)
VITE_API_URL=https://your-backend-service.onrender.com/api

# AI Traffic Server URL (your Render AI service URL)
VITE_AI_SERVER_URL=https://your-ai-service.onrender.com

# AI WebSocket URL (your Render AI service websocket URL)
VITE_WS_URL=wss://your-ai-service.onrender.com/ws/live
